{
    "compilerOptions": {
        "noEmit": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "strictNullChecks": true,
        "noUnusedLocals": true,
        "noImplicitThis": true,
        "noUnusedParameters": true,
        "module": "node20",
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "types": ["node"],
        "pretty": true,
        "target": "ES2022",
        "jsx": "react"
    },
    "formatCodeOptions": {
        "indentSize": 4,
        "tabSize": 4
    },
    "include": [
        "./src/index.ts",
        "./src/preload.cts",
        "./custom-typings/**/*.d.ts"
    ]
}
